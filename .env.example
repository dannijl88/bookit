# Copia este archivo a `.env` y ajusta los valores antes de `docker compose up`:
#
#   cp .env.example .env
#
# `.env` está en .gitignore y nunca debe subirse al repositorio.

# Contraseña del usuario `bookit` de PostgreSQL (y del datasource del backend).
DB_PASSWORD=change-me-postgres-password

# Secreto para firmar los JWT. HS256 exige AL MENOS 32 caracteres.
JWT_SECRET=change-me-with-a-random-string-of-at-least-32-chars

# Mailtrap (opcional). Si dejas usuario/contraseña vacíos, la app arranca igual
# pero los emails no se envían.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# Origen del frontend que el backend permite por CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# URL de la API que se incrusta en el bundle del frontend en tiempo de build.
VITE_API_URL=http://localhost:8080
